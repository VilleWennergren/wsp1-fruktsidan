<h2><%= @category['name'] %></h2>

<p><%= @category['description'] %></p>

<h3>Frukter i kategorin</h3>
<% if @fruits.empty? %>
  <p>Det finns inga frukter i den här kategorin ännu.</p>
<% else %>
  <ul>
    <% @fruits.each do |fruit| %>

      <li>

       <code> <a href="/fruits/<%= fruit['id'] %>"><%= fruit['name'] %></a> 
        
        <%= fruit['description'] %></code>


      </li>
      
    <% end %>
  </ul>
<% end %>

<p><a href="/categories">Till alla kategorier</a></p>
