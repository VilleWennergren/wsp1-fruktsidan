<h2>Alla kategorier</h2>

<% if @categories.empty? %>
  <p>Det finns inga kategorier ännu.</p>
<% else %>
  <ul>
    <% @categories.each do |category| %>

      <li>

       <a href="/categories/<%= category['id'] %>"><%= category['name'] %></a>


          <code><%= category['description'] %></code>

      </li>

    <% end %>

  </ul>

<% end %>
